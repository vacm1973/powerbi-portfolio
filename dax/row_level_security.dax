-- =====================================================================
-- Project: Row-Level Security (RLS) Implementation
-- Description: Dynamic row-level security rule filtering data based 
--              on the authenticated user's email and assigned center.
-- =====================================================================

[UserEmail] = USERPRINCIPALNAME()
&& [DistributionCenterID] IN 
    SELECTCOLUMNS(
        FILTER(UserPermissionsMap, UserPermissionsMap[Email] = USERPRINCIPALNAME()),
        "CenterID", UserPermissionsMap[AssignedCenterID]
    )
