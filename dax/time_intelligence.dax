-- =====================================================================
-- Project: Advanced DAX Time Intelligence
-- Description: Optimized Year-Over-Year freight cost growth measure 
--              using variables (VAR) for high performance.
-- =====================================================================

Freight Cost YoY Growth % = 
VAR CurrentYearCost = [Total Freight Cost]
VAR PriorYearCost = 
    CALCULATE(
        [Total Freight Cost],
        SAMEPERIODLASTYEAR('Calendar'[Date])
    )
VAR Result = 
    DIVIDE(
        CurrentYearCost - PriorYearCost,
        PriorYearCost,
        0
    )
RETURN
    Result
